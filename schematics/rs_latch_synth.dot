digraph G {rankdir=LR; bgcolor="white"; node [fontname="DejaVu Sans",fontsize=11];
b0 [shape=box,style="rounded,filled",fillcolor="#E7EFF8",label="wrap_s = s"];
b0 -> "wrap_s";
"s" -> b0;
b1 [shape=box,style="rounded,filled",fillcolor="#E7EFF8",label="wrap_r = r"];
b1 -> "wrap_r";
"r" -> b1;
b2 [shape=box,style="rounded,filled",fillcolor="#E7EFF8",label="q = wrap_q"];
b2 -> "q";
"wrap_q" -> b2;
b3 [shape=box,style="rounded,filled",fillcolor="#E7EFF8",label="qn = wrap_qn"];
b3 -> "qn";
"wrap_qn" -> b3;
b4 [shape=box,style="rounded,filled",fillcolor="#E7EFF8",label="wrap_q = qi"];
b4 -> "wrap_q";
"qi" -> b4;
b5 [shape=box,style="rounded,filled",fillcolor="#E7EFF8",label="wrap_qn = qni"];
b5 -> "wrap_qn";
"qni" -> b5;
b6 [shape=box,style="rounded,filled",fillcolor="#E7EFF8",label="qi = n3"];
b6 -> "qi";
"n3" -> b6;
b7 [shape=box,style="rounded,filled",fillcolor="#E7EFF8",label="qni = n5"];
b7 -> "qni";
"n5" -> b7;
b8 [shape=box,style="rounded,filled",fillcolor="#E7EFF8",label="n2 = wrap_r or qni"];
b8 -> "n2";
"qni" -> b8;
"wrap_r" -> b8;
b9 [shape=box,style="rounded,filled",fillcolor="#E7EFF8",label="n3 = not n2"];
b9 -> "n3";
"n2" -> b9;
b10 [shape=box,style="rounded,filled",fillcolor="#E7EFF8",label="n4 = wrap_s or qi"];
b10 -> "n4";
"qi" -> b10;
"wrap_s" -> b10;
b11 [shape=box,style="rounded,filled",fillcolor="#E7EFF8",label="n5 = not n4"];
b11 -> "n5";
"n4" -> b11;
}