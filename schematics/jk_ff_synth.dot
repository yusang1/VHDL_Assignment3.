digraph G {rankdir=LR; bgcolor="white"; node [fontname="DejaVu Sans",fontsize=11];
b0 [shape=box,style="rounded,filled",fillcolor="#E7EFF8",label="Register: rising edge"];
b0 -> "n21";
"n18" -> b0;
"wrap_clk" -> b0;
b1 [shape=box,style="rounded,filled",fillcolor="#E7EFF8",label="wrap_j = j"];
b1 -> "wrap_j";
"j" -> b1;
b2 [shape=box,style="rounded,filled",fillcolor="#E7EFF8",label="wrap_k = k"];
b2 -> "wrap_k";
"k" -> b2;
b3 [shape=box,style="rounded,filled",fillcolor="#E7EFF8",label="wrap_clk = clk"];
b3 -> "wrap_clk";
"clk" -> b3;
b4 [shape=box,style="rounded,filled",fillcolor="#E7EFF8",label="q = wrap_q"];
b4 -> "q";
"wrap_q" -> b4;
b5 [shape=box,style="rounded,filled",fillcolor="#E7EFF8",label="wrap_q = qi"];
b5 -> "wrap_q";
"qi" -> b5;
b6 [shape=box,style="rounded,filled",fillcolor="#E7EFF8",label="qi = n21"];
b6 -> "qi";
"n21" -> b6;
b7 [shape=box,style="rounded,filled",fillcolor="#E7EFF8",label="n4 = wrap_j & wrap_k"];
b7 -> "n4";
"wrap_j" -> b7;
"wrap_k" -> b7;
b8 [shape=box,style="rounded,filled",fillcolor="#E7EFF8",label="n6 = '1' when n4 = \"00\" else '0'"];
b8 -> "n6";
"n4" -> b8;
b9 [shape=box,style="rounded,filled",fillcolor="#E7EFF8",label="n8 = '1' when n4 = \"01\" else '0'"];
b9 -> "n8";
"n4" -> b9;
b10 [shape=box,style="rounded,filled",fillcolor="#E7EFF8",label="n10 = '1' when n4 = \"10\" else '0'"];
b10 -> "n10";
"n4" -> b10;
b11 [shape=box,style="rounded,filled",fillcolor="#E7EFF8",label="n11 = not qi"];
b11 -> "n11";
"qi" -> b11;
b12 [shape=box,style="rounded,filled",fillcolor="#E7EFF8",label="n13 = '1' when n4 = \"11\" else '0'"];
b12 -> "n13";
"n4" -> b12;
b13 [shape=box,style="rounded,filled",fillcolor="#E7EFF8",label="n14 = n13 & n10 & n8 & n6"];
b13 -> "n14";
"n10" -> b13;
"n13" -> b13;
"n6" -> b13;
"n8" -> b13;
b14 [shape=box,style="rounded,filled",fillcolor="#E7EFF8",label="n18 = n11 when \"1000\", '1' when \"0100\", '0' when \"0010\", qi when \"0001\", 'X' when others"];
b14 -> "n18";
"n11" -> b14;
"qi" -> b14;
}