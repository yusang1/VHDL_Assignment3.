digraph G {rankdir=LR; bgcolor="white"; node [fontname="DejaVu Sans",fontsize=11];
b0 [shape=box,style="rounded,filled",fillcolor="#E7EFF8",label="Async D register\nreset=n10, value=n6"];
b0 -> "n11";
"n10" -> b0;
"n6" -> b0;
"wrap_clk" -> b0;
"wrap_d" -> b0;
b1 [shape=box,style="rounded,filled",fillcolor="#E7EFF8",label="wrap_d = d"];
b1 -> "wrap_d";
"d" -> b1;
b2 [shape=box,style="rounded,filled",fillcolor="#E7EFF8",label="wrap_clk = clk"];
b2 -> "wrap_clk";
"clk" -> b2;
b3 [shape=box,style="rounded,filled",fillcolor="#E7EFF8",label="wrap_set = set"];
b3 -> "wrap_set";
"set" -> b3;
b4 [shape=box,style="rounded,filled",fillcolor="#E7EFF8",label="wrap_clr = clr"];
b4 -> "wrap_clr";
"clr" -> b4;
b5 [shape=box,style="rounded,filled",fillcolor="#E7EFF8",label="q = wrap_q"];
b5 -> "q";
"wrap_q" -> b5;
b6 [shape=box,style="rounded,filled",fillcolor="#E7EFF8",label="wrap_q = n11"];
b6 -> "wrap_q";
"n11" -> b6;
b7 [shape=box,style="rounded,filled",fillcolor="#E7EFF8",label="n6 = '1' when wrap_clr = '0' else '0'"];
b7 -> "n6";
"wrap_clr" -> b7;
b8 [shape=box,style="rounded,filled",fillcolor="#E7EFF8",label="n10 = wrap_clr or wrap_set"];
b8 -> "n10";
"wrap_clr" -> b8;
"wrap_set" -> b8;
}