digraph G {rankdir=LR; bgcolor="white"; node [fontname="DejaVu Sans",fontsize=11];
b0 [shape=box,style="rounded,filled",fillcolor="#E7EFF8",label="wrap_d = d"];
b0 -> "wrap_d";
"d" -> b0;
b1 [shape=box,style="rounded,filled",fillcolor="#E7EFF8",label="wrap_en = en"];
b1 -> "wrap_en";
"en" -> b1;
b2 [shape=box,style="rounded,filled",fillcolor="#E7EFF8",label="q = wrap_q"];
b2 -> "q";
"wrap_q" -> b2;
b3 [shape=box,style="rounded,filled",fillcolor="#E7EFF8",label="wrap_q = qi"];
b3 -> "wrap_q";
"qi" -> b3;
b4 [shape=box,style="rounded,filled",fillcolor="#E7EFF8",label="qi = n5"];
b4 -> "qi";
"n5" -> b4;
b5 [shape=box,style="rounded,filled",fillcolor="#E7EFF8",label="n5 = wrap_d when wrap_en = '1' else n5"];
b5 -> "n5";
"wrap_d" -> b5;
"wrap_en" -> b5;
}