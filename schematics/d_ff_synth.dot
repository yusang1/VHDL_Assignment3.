digraph G {rankdir=LR; bgcolor="white"; node [fontname="DejaVu Sans",fontsize=11];
b0 [shape=box,style="rounded,filled",fillcolor="#E7EFF8",label="Register: rising edge"];
b0 -> "n6";
"wrap_clk" -> b0;
"wrap_d" -> b0;
b1 [shape=box,style="rounded,filled",fillcolor="#E7EFF8",label="wrap_d = d"];
b1 -> "wrap_d";
"d" -> b1;
b2 [shape=box,style="rounded,filled",fillcolor="#E7EFF8",label="wrap_clk = clk"];
b2 -> "wrap_clk";
"clk" -> b2;
b3 [shape=box,style="rounded,filled",fillcolor="#E7EFF8",label="q = wrap_q"];
b3 -> "q";
"wrap_q" -> b3;
b4 [shape=box,style="rounded,filled",fillcolor="#E7EFF8",label="wrap_q = n6"];
b4 -> "wrap_q";
"n6" -> b4;
}